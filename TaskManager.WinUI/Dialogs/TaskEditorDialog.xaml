<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="TaskManager_WinUI.Dialogs.TaskEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TaskManager_WinUI.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Task details" PrimaryButtonText="Save task" CloseButtonText="Cancel"
    DefaultButton="Primary" PrimaryButtonClick="ContentDialog_PrimaryButtonClick" mc:Ignorable="d">
    <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="620" Spacing="14" Padding="0,4,0,8">
            <TextBlock Text="Keep the essentials quick. Open more options when you need them." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBox x:Name="TitleInput" Header="Title" PlaceholderText="What needs to get done?" MaxLength="160"/>
            <TextBox x:Name="DescriptionInput" Header="Description" PlaceholderText="Add a short description" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"/>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="CategoryInput" Header="Category" HorizontalAlignment="Stretch"/><ComboBox x:Name="PriorityInput" Grid.Column="1" Header="Priority" HorizontalAlignment="Stretch"/></Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CalendarDatePicker x:Name="DueInput" Header="Due date" HorizontalAlignment="Stretch"/><ToggleSwitch x:Name="CompletedInput" Grid.Column="1" Header="Status" OnContent="Completed" OffContent="Pending" VerticalAlignment="Bottom"/></Grid>
            <Expander Header="More options" HorizontalAlignment="Stretch">
                <StackPanel Spacing="14" Padding="0,12,0,2">
                    <TextBox x:Name="TagsInput" Header="Tags" PlaceholderText="Study, Focus, Home" Description="Separate tags with commas." MaxLength="300"/>
                    <TextBox x:Name="NotesInput" Header="Notes" PlaceholderText="Add reference notes or longer details" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxLength="12000"/>
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="RecurrenceInput" Header="Repeat" HorizontalAlignment="Stretch"/><StackPanel Grid.Column="1"><ToggleSwitch x:Name="ReminderEnabled" Header="Reminder" Toggled="ReminderEnabled_Toggled"/><Grid x:Name="ReminderFields" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CalendarDatePicker x:Name="ReminderDate"/><TimePicker x:Name="ReminderTime" Grid.Column="1" ClockIdentifier="24HourClock"/></Grid></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Subtasks" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="SubtaskProgress" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="Add subtask" Click="AddSubtask_Click"/></Grid>
                    <ListView x:Name="SubtaskList" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate x:DataType="local:SubtaskEditViewModel"><Grid ColumnSpacing="6" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{x:Bind IsCompleted,Mode=TwoWay}" Checked="SubtaskCompletionChanged" Unchecked="SubtaskCompletionChanged"/><TextBox Grid.Column="1" Text="{x:Bind Title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Subtask title"/><Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Click="MoveSubtaskUp_Click" ToolTipService.ToolTip="Move up"><FontIcon Glyph="&#xE70E;"/></Button><Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Click="MoveSubtaskDown_Click" ToolTipService.ToolTip="Move down"><FontIcon Glyph="&#xE70D;"/></Button><Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Click="RemoveSubtask_Click" ToolTipService.ToolTip="Remove"><FontIcon Glyph="&#xE711;"/></Button></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>
            <InfoBar x:Name="ValidationBar" Severity="Error" IsOpen="False" IsClosable="False"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
