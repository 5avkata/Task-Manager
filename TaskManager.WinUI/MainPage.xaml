<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TaskManager_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:TaskManager_WinUI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    KeyDown="Page_KeyDown" SizeChanged="Page_SizeChanged" mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="TaskCardTemplate" x:DataType="vm:TaskCardViewModel">
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,12" Margin="0,0,0,8">
                <Border.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Edit" Click="EditTask_Click"/><MenuFlyoutItem Text="Delete" Click="DeleteTask_Click"/></MenuFlyout></Border.ContextFlyout>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{x:Bind IsCompleted,Mode=OneWay}" Click="CompleteTask_Click" ToolTipService.ToolTip="Toggle completion" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" Opacity="{x:Bind IsCompleted,Converter={StaticResource BoolOpacityConverter}}"/>
                        <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind HasDescription,Converter={StaticResource BoolVisibility}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Style="{StaticResource PillStyle}"><TextBlock Text="{x:Bind Category}" FontSize="12"/></Border>
                            <Border Style="{StaticResource PillStyle}" BorderBrush="{x:Bind PriorityValue,Converter={StaticResource PriorityBrush}}" BorderThickness="0,0,0,2"><TextBlock Text="{x:Bind Priority}" FontSize="12" Foreground="{x:Bind PriorityValue,Converter={StaticResource PriorityBrush}}"/></Border>
                            <Border Style="{StaticResource PillStyle}" Visibility="{x:Bind HasSubtasks,Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE73A;" FontSize="11"/><TextBlock Text="{x:Bind SubtaskText}" FontSize="12"/></StackPanel></Border>
                            <FontIcon Glyph="&#xE7ED;" FontSize="13" Visibility="{x:Bind HasReminder,Converter={StaticResource BoolVisibility}}" ToolTipService.ToolTip="Reminder set"/>
                            <FontIcon Glyph="&#xE895;" FontSize="13" Visibility="{x:Bind IsRecurring,Converter={StaticResource BoolVisibility}}" ToolTipService.ToolTip="Recurring task"/>
                            <ItemsControl ItemsSource="{x:Bind VisibleTags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SoftAccentBrush}" CornerRadius="7" Padding="7,3"><TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource AppAccentBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <ProgressBar Value="{x:Bind SubtaskProgress}" Maximum="100" Height="3" Visibility="{x:Bind HasSubtasks,Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" MinWidth="96" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{x:Bind DueText}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind DueDetail}" HorizontalAlignment="Right" Foreground="{StaticResource DangerBrush}" FontSize="12"/></StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <CheckBox IsChecked="{x:Bind IsSelected,Mode=TwoWay}" Checked="TaskSelectionChanged" Unchecked="TaskSelectionChanged" ToolTipService.ToolTip="Select task"/>
                        <Button Style="{StaticResource SubtleButtonStyle}" Click="EditTask_Click" ToolTipService.ToolTip="Edit task"><FontIcon Glyph="&#xE70F;"/></Button>
                        <Button Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="More actions"><FontIcon Glyph="&#xE712;"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Edit" Click="EditTask_Click"/><MenuFlyoutItem Text="Delete" Click="DeleteTask_Click"/></MenuFlyout></Button.Flyout></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactTaskTemplate" x:DataType="vm:TaskCardViewModel">
            <Button Style="{StaticResource SubtleButtonStyle}" HorizontalContentAlignment="Stretch" Click="EditTask_Click" Margin="0,0,0,4">
                <Grid ColumnSpacing="10" Padding="5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{x:Bind PriorityValue,Converter={StaticResource PriorityBrush}}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind DueText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" PaneDisplayMode="Auto" OpenPaneLength="220" CompactPaneLength="56" CompactModeThresholdWidth="780" ExpandedModeThresholdWidth="1100" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#17243A"/>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#17243A"/>
                <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#EAF0FA"/>
                <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="White"/>
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="White"/>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#253858"/>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#304A73"/>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#365482"/>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Grid Margin="6,12,10,18" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" Background="#3468E8" CornerRadius="10"><FontIcon Glyph="&#xE8FD;" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="Task Manager" FontSize="15" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Plan with clarity" FontSize="11" Foreground="#AFC0D9"/></StackPanel>
                </Grid>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" IsSelected="True"/>
                <NavigationViewItem Content="Today" Tag="Today"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Upcoming" Tag="Upcoming"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Calendar" Tag="Calendar"><NavigationViewItem.Icon><FontIcon Glyph="&#xE787;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="All Tasks" Tag="AllTasks"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Completed" Tag="Completed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE930;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid Padding="28,20,28,18" MaxWidth="1500" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" FontSize="30"/><TextBlock x:Name="PageSubtitle" Text="What needs your attention today" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="NewTask_Click" Padding="18,10"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="New task"/></StackPanel></Button>
                    </Grid>
                    <Grid x:Name="SearchBar" Grid.Row="1" ColumnSpacing="10" Margin="0,0,0,16" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search tasks, notes, tags, and subtasks" QueryIcon="Find" TextChanged="SearchBox_TextChanged" MinWidth="320"/>
                        <Button Grid.Column="1" Click="FilterButton_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE71C;"/><TextBlock Text="Filters"/><Border x:Name="FilterCountBadge" Background="{StaticResource AppAccentBrush}" CornerRadius="8" Padding="6,1" Visibility="Collapsed"><TextBlock x:Name="FilterCountText" Foreground="White" FontSize="11"/></Border></StackPanel></Button>
                        <ComboBox x:Name="SortSelector" Grid.Column="2" Width="148" SelectedIndex="0" SelectionChanged="SortSelector_SelectionChanged" ToolTipService.ToolTip="Sort tasks"><ComboBoxItem Content="Due date" Tag="DueDate"/><ComboBoxItem Content="Priority" Tag="Priority"/></ComboBox>
                        <Button Grid.Column="3" x:Name="ClearFiltersButton" Content="Clear" Click="ClearFilters_Click" Visibility="Collapsed"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="DashboardView"><StackPanel Spacing="18">
                            <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24"><StackPanel Spacing="14"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="{StaticResource SoftAccentBrush}" CornerRadius="10" Padding="9"><FontIcon Glyph="&#xE823;" Foreground="{StaticResource AppAccentBrush}"/></Border><StackPanel><TextBlock Text="Focus for today" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="FocusSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel><ItemsControl ItemsSource="{x:Bind ViewModel.TodayPreview,Mode=OneWay}" ItemTemplate="{StaticResource CompactTaskTemplate}"/><InfoBar x:Name="DashboardEmpty" Severity="Success" IsOpen="False" Message="Nothing urgent. You are clear for today." IsClosable="False"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="24"><StackPanel Spacing="16"><TextBlock Text="Progress" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid><ProgressRing x:Name="CompletionRing" Width="116" Height="116" IsActive="False"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="CompletionPercent" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="complete" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="WeekMetric" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="This week" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="MonthMetric" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="This month" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="OverdueMetric" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Overdue" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></StackPanel></Border>
                            </Grid>
                            <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="12"><TextBlock Text="Priority balance" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="High"/><ProgressBar x:Name="HighBar" Grid.Column="1" Maximum="100" Foreground="{StaticResource DangerBrush}"/><TextBlock x:Name="HighCount" Grid.Column="2" HorizontalAlignment="Right"/></Grid><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="Medium"/><ProgressBar x:Name="MediumBar" Grid.Column="1" Maximum="100" Foreground="{StaticResource WarningBrush}"/><TextBlock x:Name="MediumCount" Grid.Column="2" HorizontalAlignment="Right"/></Grid><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="Low"/><ProgressBar x:Name="LowBar" Grid.Column="1" Maximum="100" Foreground="{StaticResource SuccessBrush}"/><TextBlock x:Name="LowCount" Grid.Column="2" HorizontalAlignment="Right"/></Grid></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="12"><TextBlock Text="Coming up" Style="{StaticResource SubtitleTextBlockStyle}"/><ItemsControl ItemsSource="{x:Bind ViewModel.UpcomingPreview,Mode=OneWay}" ItemTemplate="{StaticResource CompactTaskTemplate}"/><TextBlock x:Name="UpcomingEmpty" Text="No upcoming tasks." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
                            </Grid>
                        </StackPanel></ScrollViewer>
                        <ScrollViewer x:Name="TasksView" Visibility="Collapsed">
                            <Grid x:Name="TasksWorkspace" ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel x:Name="TaskListColumn" Spacing="12">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Groups,Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:TaskGroupViewModel"><StackPanel Spacing="8" Margin="0,0,0,16"><TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}"/><ItemsControl ItemsSource="{x:Bind Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <StackPanel x:Name="TasksEmpty" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,70,0,0" Spacing="12"><FontIcon Glyph="&#xE8FD;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><TextBlock x:Name="EmptyTitle" Text="Nothing here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyMessage" Text="Create a task to get started." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="Create task" Style="{StaticResource AccentButtonStyle}" Click="NewTask_Click" HorizontalAlignment="Center"/></StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="TaskInsightsColumn" Grid.Column="1" Spacing="12">
                                    <Border x:Name="TodayOverviewPanel" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed"><StackPanel Spacing="16"><TextBlock Text="Today overview" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TodayCompletedCount" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Completed today" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="TodayRemainingCount" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Remaining" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid><ProgressBar x:Name="TodayProgress" Maximum="100"/><TextBlock x:Name="TodayProgressText" HorizontalAlignment="Right" FontWeight="SemiBold"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TodayOverdueCount" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Overdue" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="TodayHighCount" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="High priority" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></StackPanel></Border>
                                    <Border x:Name="TodayNextPanel" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed"><StackPanel Spacing="8"><TextBlock Text="Next deadline" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="TodayNextTitle" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TodayNextMeta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border x:Name="UpcomingOverviewPanel" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed"><StackPanel Spacing="14"><TextBlock Text="Planning overview" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="UpcomingSevenCount" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Next 7 days" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="UpcomingHighCount" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="High priority" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid><TextBlock Text="Next important task" FontWeight="SemiBold"/><TextBlock x:Name="UpcomingNextTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="UpcomingNextMeta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border x:Name="UpcomingPreviewPanel" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed"><StackPanel Spacing="10"><TextBlock Text="Coming next" Style="{StaticResource BodyStrongTextBlockStyle}"/><ItemsControl x:Name="UpcomingSideList" ItemTemplate="{StaticResource CompactTaskTemplate}"/><TextBlock x:Name="NoUpcomingSide" Text="No upcoming deadlines." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
                                    <Border x:Name="AllOverviewPanel" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed"><StackPanel Spacing="15"><TextBlock Text="Task overview" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AllActiveCount" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Active" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="AllCompletedCount" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Completed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="AllOverdueCount" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Overdue" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid><TextBlock Text="By category" FontWeight="SemiBold"/><StackPanel x:Name="CategorySummaryPanel" Spacing="8"/></StackPanel></Border>
                                    <Border x:Name="DueSoonPanel" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed"><StackPanel Spacing="10"><TextBlock Text="Due soon" Style="{StaticResource BodyStrongTextBlockStyle}"/><ItemsControl x:Name="DueSoonList" ItemTemplate="{StaticResource CompactTaskTemplate}"/><TextBlock x:Name="NoDueSoon" Text="Nothing is due in the next seven days." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border x:Name="CompletedOverviewPanel" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed"><StackPanel Spacing="15"><TextBlock Text="Completion overview" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CompletedWeekCount" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="This week" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="CompletedMonthCount" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="This month" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid><TextBlock x:Name="CompletedRateText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border x:Name="RecentCompletedPanel" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed"><StackPanel Spacing="10"><TextBlock Text="Recent completions" Style="{StaticResource BodyStrongTextBlockStyle}"/><ItemsControl x:Name="RecentCompletedList" ItemTemplate="{StaticResource CompactTaskTemplate}"/><TextBlock x:Name="NoRecentCompleted" Text="No recent completions yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                        <Grid x:Name="CalendarView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CalendarMonth" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Today" Click="CalendarToday_Click" Margin="0,0,8,0"/><Button Grid.Column="2" Click="CalendarPrevious_Click" ToolTipService.ToolTip="Previous month"><FontIcon Glyph="&#xE76B;"/></Button><Button Grid.Column="3" Click="CalendarNext_Click" ToolTipService.ToolTip="Next month"><FontIcon Glyph="&#xE76C;"/></Button></Grid><Grid Grid.Row="1" x:Name="CalendarWeekdays" Margin="0,0,0,6"/><Grid Grid.Row="2" x:Name="CalendarGrid"/><Border Grid.Row="3" Style="{StaticResource SurfaceCardStyle}" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedDayTitle" Style="{StaticResource BodyStrongTextBlockStyle}"/><Button Grid.Column="1" Content="Add task for this day" Click="NewTaskForDay_Click"/></Grid><ListView x:Name="SelectedDayTasks" Grid.Row="1" ItemTemplate="{StaticResource CompactTaskTemplate}" SelectionMode="None"/><TextBlock x:Name="CalendarDayEmpty" Grid.Row="1" Text="No tasks scheduled." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid>
                        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"><StackPanel Spacing="18" MaxWidth="780" HorizontalAlignment="Left"><Border Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="12"><TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="Choose how Task Manager follows Windows." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ComboBox x:Name="ThemeSelector" Width="220" HorizontalAlignment="Left" SelectionChanged="ThemeSelector_SelectionChanged"><ComboBoxItem Content="Use system setting" Tag="System"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/></ComboBox></StackPanel></Border><Border Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="12"><TextBlock Text="Categories and tags" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="Manage the labels available when organizing tasks." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel x:Name="CategoryChips" Orientation="Horizontal" Spacing="8"/><Button Content="Add category" HorizontalAlignment="Left" Click="AddCategory_Click"/><StackPanel x:Name="TagChips" Orientation="Horizontal" Spacing="8"/><Button Content="Add tag" HorizontalAlignment="Left" Click="AddTag_Click"/></StackPanel></Border><Border Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="12"><TextBlock Text="Backup and data" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="Keep a portable copy of your tasks or restore a validated backup." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Export backup" Click="ExportBackup_Click"/><Button Content="Import backup" Click="ImportBackup_Click"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
                    </Grid>
                    <Grid x:Name="BulkBar" Grid.Row="3" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="12" Padding="12" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BulkCount" VerticalAlignment="Center" FontWeight="SemiBold"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button Content="Complete" Click="BulkComplete_Click"/><Button Content="Incomplete" Click="BulkIncomplete_Click"/><Button Content="Category" Click="BulkCategory_Click"/><Button Content="Priority" Click="BulkPriority_Click"/><Button Content="Delete" Click="BulkDelete_Click"/><Button Content="Cancel" Click="BulkCancel_Click"/></StackPanel></Grid>
                    <TextBlock Grid.Row="3" x:Name="StatusText" Text="{x:Bind ViewModel.StatusText,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,12,0,0"/>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <InfoBar x:Name="AppInfoBar" IsOpen="False" IsClosable="True" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="240,10,28,0"/>
    </Grid>
</Page>
