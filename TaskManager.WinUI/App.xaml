<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TaskManager_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskManager_WinUI"
    xmlns:converters="using:TaskManager_WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolVisibilityConverter x:Key="BoolVisibility" />
            <converters:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility" />
            <converters:BoolOpacityConverter x:Key="BoolOpacityConverter" />
            <converters:PriorityBrushConverter x:Key="PriorityBrush" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#3468E8" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#238968" />
            <SolidColorBrush x:Key="DangerBrush" Color="#BE4040" />
            <SolidColorBrush x:Key="WarningBrush" Color="#AD7016" />
            <SolidColorBrush x:Key="NavyBrush" Color="#17243A" />
            <SolidColorBrush x:Key="SoftAccentBrush" Color="#173468E8" />
            <Style x:Key="SurfaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style x:Key="PillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="9,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
